<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema" ?>
<package format="3">
  <name>agt_robot_bringup</name>
  <version>0.1.0</version>
  <description>Single-owner AGT robot hardware bringup layer.</description>

  <maintainer email="yangxuan@users.noreply.github.com">AGT Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>agt_robot_description</exec_depend>
  <exec_depend>bunker_base</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>agt_asensing_driver</exec_depend>
  <exec_depend>autolabor_c1_bringup</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
